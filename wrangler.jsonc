{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "undograph-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    { "binding": "BUILD_WORKFLOW", "name": "undograph-local-build", "class_name": "BuildWorkflow" }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "FALKORDB_TLS": "false",
    "GRAPH_PREFIX": "undograph_local_"
  },
  "env": {
    "preview": {
      "name": "undograph-preview",
      "ai": { "binding": "AI", "remote": true },
      "workflows": [
        { "binding": "BUILD_WORKFLOW", "name": "undograph-preview-build", "class_name": "BuildWorkflow" }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "FALKORDB_TLS": "true",
        "GRAPH_PREFIX": "undograph_preview_"
      }
    },
    "production": {
      "name": "undograph",
      "ai": { "binding": "AI", "remote": true },
      "workflows": [
        { "binding": "BUILD_WORKFLOW", "name": "undograph-production-build", "class_name": "BuildWorkflow" }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "FALKORDB_TLS": "true",
        "GRAPH_PREFIX": "undograph_production_"
      }
    }
  }
}
