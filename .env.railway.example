# Generate real values with npm run setup:railway; never commit .env.railway.
FALKORDB_PASSWORD=generate-at-least-32-random-url-safe-characters
GRAPH_GATEWAY_TOKEN=generate-at-least-32-random-url-safe-characters
GATEWAY_GRAPH_PREFIXES=undograph_preview_
PORT=8080
# Put SESSION_SECRET in Cloudflare, not in the Railway service.
SESSION_SECRET=generate-a-separate-random-session-secret
